{
  "version": "1.4",
  "meta": {
    "title": "QA Copilot",
    "resolution": [1920, 1080],
    "fps": 30,
    "theme": "storyboard_dark",
    "show_subtitles": false,
    "continuity": true
  },
  "scenes": [
    {
      "id": "title_card",
      "duration": "5s",
      "template": "storyboard",
      "narration": "This is about removing manual triage from the test cycle.",
      "objects": [
        {
          "type": "group",
          "id": "title_panel",
          "grid": {"region": "stage"},
          "layout": {"type": "stack", "gap": "medium", "align": "center"},
          "children": [
            {"type": "text", "id": "title_main", "content": "QA Copilot", "style": "heading"},
            {"type": "text", "id": "title_sub", "content": "Autonomous Test Failure Triage for CQA", "style": "caption"}
          ]
        }
      ],
      "animations": [
        {"action": "fade-in", "target": "title_panel", "at": "0s", "duration": "1s"}
      ]
    },
    {
      "id": "scale_explosion",
      "duration": "7s",
      "template": "storyboard",
      "narration": "Thousands of tests run. Hundreds of failures appear. The failure volume is overwhelming.",
      "objects": [
        {"type": "text", "id": "scale_heading", "content": "Thousands of tests. Hundreds of failures.", "style": "heading"},
        {
          "type": "group",
          "id": "failure_field",
          "grid": {"region": "stage"},
          "layout": {"type": "grid", "columns": 5, "rows": 5, "gap": "small"},
          "children": [
            {"type": "circle", "id": "failure_01", "actor_id": "signal_01", "style": "error", "size_variant": "compact"},
            {"type": "circle", "id": "failure_02", "actor_id": "signal_02", "style": "error", "size_variant": "compact"},
            {"type": "circle", "id": "failure_03", "actor_id": "signal_03", "style": "error", "size_variant": "compact"},
            {"type": "circle", "id": "failure_04", "actor_id": "signal_04", "style": "error", "size_variant": "compact"},
            {"type": "circle", "id": "failure_05", "actor_id": "signal_05", "style": "error", "size_variant": "compact"},
            {"type": "circle", "id": "failure_06", "actor_id": "signal_06", "style": "error", "size_variant": "compact"},
            {"type": "circle", "id": "failure_07", "actor_id": "signal_07", "style": "error", "size_variant": "compact"},
            {"type": "circle", "id": "failure_08", "actor_id": "signal_08", "style": "error", "size_variant": "compact"},
            {"type": "circle", "id": "failure_09", "actor_id": "signal_09", "style": "muted", "size_variant": "compact"},
            {"type": "circle", "id": "failure_10", "actor_id": "signal_10", "style": "muted", "size_variant": "compact"},
            {"type": "circle", "id": "failure_11", "actor_id": "signal_11", "style": "muted", "size_variant": "compact"},
            {"type": "circle", "id": "failure_12", "actor_id": "signal_12", "style": "muted", "size_variant": "compact"},
            {"type": "circle", "id": "failure_13", "actor_id": "signal_13", "style": "muted", "size_variant": "compact"},
            {"type": "circle", "id": "failure_14", "actor_id": "signal_14", "style": "muted", "size_variant": "compact"},
            {"type": "circle", "id": "failure_15", "actor_id": "signal_15", "style": "muted", "size_variant": "compact"},
            {"type": "circle", "id": "failure_16", "actor_id": "signal_16", "style": "muted", "size_variant": "compact"},
            {"type": "circle", "id": "failure_17", "actor_id": "signal_17", "style": "muted", "size_variant": "compact"},
            {"type": "circle", "id": "failure_18", "actor_id": "signal_18", "style": "muted", "size_variant": "compact"},
            {"type": "circle", "id": "failure_19", "actor_id": "signal_19", "style": "muted", "size_variant": "compact"},
            {"type": "circle", "id": "failure_20", "actor_id": "signal_20", "style": "muted", "size_variant": "compact"},
            {"type": "circle", "id": "failure_21", "actor_id": "signal_21", "style": "muted", "size_variant": "compact"},
            {"type": "circle", "id": "failure_22", "actor_id": "signal_22", "style": "muted", "size_variant": "compact"},
            {"type": "circle", "id": "failure_23", "actor_id": "signal_23", "style": "muted", "size_variant": "compact"},
            {"type": "circle", "id": "failure_24", "actor_id": "signal_24", "style": "muted", "size_variant": "compact"},
            {"type": "circle", "id": "failure_25", "actor_id": "signal_25", "style": "muted", "size_variant": "compact"}
          ]
        }
      ],
      "animations": [
        {"action": "fade-in", "target": "scale_heading", "at": "0s", "duration": "0.7s"},
        {"action": "fade-in", "target": "failure_field", "at": "0.2s", "duration": "1s"}
      ]
    },
    {
      "id": "bottleneck",
      "duration": "6s",
      "template": "storyboard",
      "narration": "Most failures are not product bugs. Humans are filtering noise through manual triage.",
      "objects": [
        {"type": "text", "id": "bottleneck_heading", "content": "Most failures are not product bugs", "style": "heading"},
        {
          "type": "group",
          "id": "bottleneck_stage",
          "grid": {"region": "stage"},
          "layout": {"type": "flow", "direction": "horizontal", "gap": "large", "align": "center"},
          "children": [
            {
              "type": "group",
              "id": "bottleneck_cluster",
              "layout": {"type": "grid", "columns": 3, "rows": 3, "gap": "small"},
              "children": [
                {"type": "circle", "id": "b_01", "actor_id": "signal_01", "style": "error", "size_variant": "compact"},
                {"type": "circle", "id": "b_02", "actor_id": "signal_02", "style": "error", "size_variant": "compact"},
                {"type": "circle", "id": "b_03", "actor_id": "signal_03", "style": "error", "size_variant": "compact"},
                {"type": "circle", "id": "b_04", "actor_id": "signal_04", "style": "error", "size_variant": "compact"},
                {"type": "circle", "id": "b_05", "actor_id": "signal_05", "style": "error", "size_variant": "compact"},
                {"type": "circle", "id": "b_06", "actor_id": "signal_06", "style": "error", "size_variant": "compact"},
                {"type": "circle", "id": "b_07", "actor_id": "signal_07", "style": "error", "size_variant": "compact"},
                {"type": "circle", "id": "b_08", "actor_id": "signal_08", "style": "error", "size_variant": "compact"},
                {"type": "circle", "id": "b_09", "actor_id": "signal_09", "style": "error", "size_variant": "compact"}
              ]
            },
            {"type": "box", "id": "manual_triage", "actor_id": "manual_triage", "content": "Manual Triage", "style": "muted", "size_variant": "hero"}
          ]
        }
      ],
      "animations": [
        {"action": "fade-in", "target": "bottleneck_heading", "at": "0s", "duration": "0.7s"},
        {"action": "fade-in", "target": "bottleneck_stage", "at": "0.2s", "duration": "0.8s"},
        {"action": "highlight", "target": "manual_triage", "at": "1.1s", "duration": "1.2s", "color": "warning"}
      ]
    },
    {
      "id": "golden_rule",
      "duration": "5s",
      "template": "storyboard",
      "narration": "A passing test that hides a product bug is worse than a failing test.",
      "objects": [
        {
          "type": "group",
          "id": "rule_panel",
          "grid": {"region": "stage"},
          "layout": {"type": "stack", "gap": "medium", "align": "center"},
          "children": [
            {"type": "text", "id": "rule_text", "content": "80% is noise", "style": "heading"}
          ]
        }
      ],
      "animations": [{"action": "fade-in", "target": "rule_panel", "at": "0s", "duration": "0.8s"}]
    },
    {
      "id": "agent_intro",
      "duration": "5s",
      "template": "storyboard",
      "narration": "Something new enters the system.",
      "objects": [
        {
          "type": "group",
          "id": "agent_intro_panel",
          "grid": {"region": "stage"},
          "layout": {"type": "stack", "gap": "large", "align": "center"},
          "children": [
            {"type": "circle", "id": "agent_intro_circle", "actor_id": "qa_copilot_agent", "content": "AI", "style": "success", "size_variant": "hero"},
            {"type": "text", "id": "agent_intro_label", "content": "QA Copilot", "style": "heading"}
          ]
        }
      ],
      "animations": [{"action": "fade-in", "target": "agent_intro_panel", "at": "0s", "duration": "1s"}]
    },
    {
      "id": "old_flow",
      "duration": "6s",
      "template": "storyboard",
      "narration": "The old path is test runs, then failure, then manual triage.",
      "objects": [
        {"type": "connector", "id": "old_link_1", "from": "legacy_runs", "to": "legacy_failure"},
        {"type": "connector", "id": "old_link_2", "from": "legacy_failure", "to": "legacy_manual"},
        {
          "type": "group",
          "id": "old_flow_stage",
          "grid": {"region": "stage"},
          "layout": {"type": "flow", "direction": "horizontal", "gap": "large", "align": "center"},
          "children": [
            {"type": "box", "id": "legacy_runs", "actor_id": "flow_runs", "content": "Test Runs", "style": "muted"},
            {"type": "box", "id": "legacy_failure", "actor_id": "flow_failure", "content": "Failure", "style": "warning"},
            {"type": "box", "id": "legacy_manual", "actor_id": "manual_triage", "content": "Manual Triage", "style": "muted"}
          ]
        }
      ],
      "animations": [
        {"action": "fade-in", "target": "old_flow_stage", "at": "0.2s", "duration": "0.8s"},
        {"action": "draw", "target": "old_link_1", "at": "0.7s", "duration": "0.6s"},
        {"action": "draw", "target": "old_link_2", "at": "1.0s", "duration": "0.6s"}
      ]
    },
    {
      "id": "intercepted_flow",
      "duration": "6s",
      "template": "storyboard",
      "narration": "QA Copilot intercepts the failure in real time, and the manual path falls away.",
      "objects": [
        {"type": "connector", "id": "new_link_1", "from": "new_runs", "to": "new_failure"},
        {"type": "connector", "id": "new_link_2", "from": "new_agent", "to": "new_failure"},
        {
          "type": "group",
          "id": "new_flow_stage",
          "grid": {"region": "stage"},
          "layout": {"type": "flow", "direction": "horizontal", "gap": "large", "align": "center"},
          "children": [
            {"type": "box", "id": "new_runs", "actor_id": "flow_runs", "content": "Test Runs", "style": "muted"},
            {"type": "box", "id": "new_failure", "actor_id": "flow_failure", "content": "Failure", "style": "warning"},
            {"type": "circle", "id": "new_agent", "actor_id": "qa_copilot_agent", "content": "AI", "style": "success", "size_variant": "hero"},
            {"type": "box", "id": "manual_offscreen", "actor_id": "manual_triage", "content": "Manual Triage", "style": "muted"}
          ]
        }
      ],
      "animations": [
        {"action": "fade-in", "target": "new_flow_stage", "at": "0.2s", "duration": "0.8s"},
        {"action": "draw", "target": "new_link_1", "at": "0.7s", "duration": "0.6s"},
        {"action": "draw", "target": "new_link_2", "at": "1.0s", "duration": "0.6s"},
        {"action": "fade-out", "target": "manual_offscreen", "at": "1.2s", "duration": "0.8s"}
      ]
    },
    {
      "id": "inspection",
      "duration": "6s",
      "template": "storyboard",
      "narration": "It is not a parser. It is an investigator running directly on the system under test.",
      "objects": [
        {"type": "connector", "id": "inspect_logs_link", "from": "inspect_agent", "to": "inspect_logs"},
        {"type": "connector", "id": "inspect_fs_link", "from": "inspect_agent", "to": "inspect_fs"},
        {"type": "connector", "id": "inspect_gpu_link", "from": "inspect_agent", "to": "inspect_gpu"},
        {
          "type": "group",
          "id": "inspect_stage",
          "grid": {"region": "stage"},
          "layout": {"type": "stack", "gap": "large", "align": "center"},
          "children": [
            {"type": "circle", "id": "inspect_agent", "actor_id": "qa_copilot_agent", "content": "AI", "style": "success", "size_variant": "hero"},
            {
              "type": "group",
              "id": "inspect_targets",
              "layout": {"type": "flow", "direction": "horizontal", "gap": "large", "align": "center"},
              "children": [
                {"type": "token", "id": "inspect_logs", "content": "Logs", "style": "muted"},
                {"type": "token", "id": "inspect_fs", "content": "Filesystem", "style": "muted"},
                {"type": "token", "id": "inspect_gpu", "content": "GPU State", "style": "muted"}
              ]
            }
          ]
        }
      ],
      "animations": [
        {"action": "fade-in", "target": "inspect_stage", "at": "0.2s", "duration": "0.8s"},
        {"action": "draw", "target": "inspect_logs_link", "at": "0.8s", "duration": "0.6s"},
        {"action": "draw", "target": "inspect_fs_link", "at": "1.0s", "duration": "0.6s"},
        {"action": "draw", "target": "inspect_gpu_link", "at": "1.2s", "duration": "0.6s"}
      ]
    },
    {
      "id": "decision_engine",
      "duration": "6s",
      "template": "storyboard",
      "narration": "The agent classifies failures into product bugs, automation bugs, environment problems, or unknowns.",
      "objects": [
        {"type": "connector", "id": "decision_link_1", "from": "decision_source", "to": "decision_product"},
        {"type": "connector", "id": "decision_link_2", "from": "decision_source", "to": "decision_automation"},
        {"type": "connector", "id": "decision_link_3", "from": "decision_source", "to": "decision_environment"},
        {"type": "connector", "id": "decision_link_4", "from": "decision_source", "to": "decision_unknown"},
        {
          "type": "group",
          "id": "decision_stage",
          "grid": {"region": "stage"},
          "layout": {"type": "stack", "gap": "large", "align": "center"},
          "children": [
            {"type": "box", "id": "decision_source", "content": "Classification", "style": "primary"},
            {
              "type": "group",
              "id": "decision_targets",
              "layout": {"type": "flow", "direction": "horizontal", "gap": "medium", "align": "center"},
              "children": [
                {"type": "token", "id": "decision_product", "content": "Product Bug", "style": "error"},
                {"type": "token", "id": "decision_automation", "content": "Automation Bug", "style": "success"},
                {"type": "token", "id": "decision_environment", "content": "Environment", "style": "warning"},
                {"type": "token", "id": "decision_unknown", "content": "Unknown", "style": "muted"}
              ]
            }
          ]
        }
      ],
      "animations": [
        {"action": "fade-in", "target": "decision_stage", "at": "0.2s", "duration": "0.8s"},
        {"action": "draw", "target": "decision_link_1", "at": "0.8s", "duration": "0.5s"},
        {"action": "draw", "target": "decision_link_2", "at": "0.95s", "duration": "0.5s"},
        {"action": "draw", "target": "decision_link_3", "at": "1.1s", "duration": "0.5s"},
        {"action": "draw", "target": "decision_link_4", "at": "1.25s", "duration": "0.5s"}
      ]
    },
    {
      "id": "action_layer",
      "duration": "6s",
      "template": "storyboard",
      "narration": "The agent does not stop at classification. Each branch has a concrete next action.",
      "objects": [
        {
          "type": "group",
          "id": "action_stage",
          "grid": {"region": "stage"},
          "layout": {"type": "grid", "columns": 2, "rows": 2, "gap": "medium"},
          "children": [
            {"type": "box", "id": "action_product", "content": "Product Bug -> Fail + Evidence", "style": "error"},
            {"type": "box", "id": "action_automation", "content": "Automation Bug -> Fix + Rerun", "style": "success"},
            {"type": "box", "id": "action_environment", "content": "Environment -> Rerun", "style": "warning"},
            {"type": "box", "id": "action_unknown", "content": "Unknown -> Escalate", "style": "muted"}
          ]
        }
      ],
      "animations": [{"action": "fade-in", "target": "action_stage", "at": "0.2s", "duration": "0.9s"}]
    },
    {
      "id": "aggregation",
      "duration": "6s",
      "template": "storyboard",
      "narration": "Across systems under test, failures regroup into stable root-cause clusters.",
      "objects": [
        {
          "type": "group",
          "id": "aggregation_stage",
          "grid": {"region": "stage"},
          "layout": {"type": "flow", "direction": "horizontal", "gap": "large", "align": "center"},
          "children": [
            {
              "type": "group",
              "id": "aggregation_cloud",
              "layout": {"type": "grid", "columns": 3, "rows": 3, "gap": "small"},
              "children": [
                {"type": "circle", "id": "agg_1", "style": "error", "size_variant": "compact"},
                {"type": "circle", "id": "agg_2", "style": "error", "size_variant": "compact"},
                {"type": "circle", "id": "agg_3", "style": "error", "size_variant": "compact"},
                {"type": "circle", "id": "agg_4", "style": "error", "size_variant": "compact"},
                {"type": "circle", "id": "agg_5", "style": "error", "size_variant": "compact"},
                {"type": "circle", "id": "agg_6", "style": "error", "size_variant": "compact"},
                {"type": "circle", "id": "agg_7", "style": "error", "size_variant": "compact"},
                {"type": "circle", "id": "agg_8", "style": "error", "size_variant": "compact"},
                {"type": "circle", "id": "agg_9", "style": "error", "size_variant": "compact"}
              ]
            },
            {
              "type": "group",
              "id": "aggregation_clusters",
              "layout": {"type": "stack", "gap": "medium", "align": "center"},
              "children": [
                {"type": "box", "id": "cluster_a", "content": "ERR-902 -> Automation", "style": "success"},
                {"type": "box", "id": "cluster_b", "content": "ERR-415 -> Product Bug", "style": "success"},
                {"type": "box", "id": "cluster_c", "content": "ERR-121 -> Environment", "style": "success"}
              ]
            }
          ]
        }
      ],
      "animations": [{"action": "fade-in", "target": "aggregation_stage", "at": "0.2s", "duration": "0.8s"}]
    },
    {
      "id": "bug_filing",
      "duration": "6s",
      "template": "storyboard",
      "narration": "Messy logs become a structured bug draft with evidence attached.",
      "objects": [
        {"type": "connector", "id": "bug_link", "from": "log_block", "to": "bug_draft"},
        {
          "type": "group",
          "id": "bug_stage",
          "grid": {"region": "stage"},
          "layout": {"type": "flow", "direction": "horizontal", "gap": "large", "align": "center"},
          "children": [
            {
              "type": "group",
              "id": "log_block",
              "layout": {"type": "stack", "gap": "small", "align": "left"},
              "children": [
                {"type": "text", "id": "log_1", "content": "trace line 1", "style": "caption"},
                {"type": "text", "id": "log_2", "content": "trace line 2", "style": "caption"},
                {"type": "text", "id": "log_3", "content": "trace line 3", "style": "caption"}
              ]
            },
            {
              "type": "group",
              "id": "bug_draft",
              "layout": {"type": "stack", "gap": "small", "align": "left"},
              "children": [
                {"type": "box", "id": "bug_title", "content": "Create NVBug Draft", "style": "primary"},
                {"type": "token", "id": "bug_owner", "content": "Owner: CQA", "style": "success"},
                {"type": "token", "id": "bug_evidence", "content": "Evidence attached", "style": "accent"}
              ]
            }
          ]
        }
      ],
      "animations": [
        {"action": "fade-in", "target": "bug_stage", "at": "0.2s", "duration": "0.8s"},
        {"action": "draw", "target": "bug_link", "at": "0.9s", "duration": "0.7s"}
      ]
    },
    {
      "id": "onboarding",
      "duration": "5s",
      "template": "storyboard",
      "narration": "Setup stays simple. Engineers enable the flag and clone the repo. No framework changes are required.",
      "objects": [
        {
          "type": "group",
          "id": "onboarding_stage",
          "grid": {"region": "stage"},
          "layout": {"type": "flow", "direction": "horizontal", "gap": "large", "align": "center"},
          "children": [
            {"type": "box", "id": "onboarding_enable", "content": "Enable flag", "style": "accent"},
            {"type": "box", "id": "onboarding_clone", "content": "Clone repo", "style": "accent"}
          ]
        }
      ],
      "animations": [{"action": "fade-in", "target": "onboarding_stage", "at": "0.2s", "duration": "0.8s"}]
    },
    {
      "id": "impact",
      "duration": "6s",
      "template": "storyboard",
      "narration": "Manual triage takes hours. QA Copilot turns that into seconds.",
      "objects": [
        {
          "type": "group",
          "id": "impact_stage",
          "grid": {"region": "stage"},
          "layout": {"type": "flow", "direction": "horizontal", "gap": "large", "align": "center"},
          "children": [
            {
              "type": "group",
              "id": "impact_before",
              "layout": {"type": "stack", "gap": "small", "align": "center"},
              "children": [
                {"type": "text", "id": "impact_before_label", "content": "Manual triage", "style": "section-heading"},
                {"type": "text", "id": "impact_before_metric", "content": "Hours", "style": "heading"}
              ]
            },
            {
              "type": "group",
              "id": "impact_after",
              "layout": {"type": "stack", "gap": "small", "align": "center"},
              "children": [
                {"type": "text", "id": "impact_after_label", "content": "QA Copilot", "style": "section-heading"},
                {"type": "text", "id": "impact_after_metric", "content": "Seconds", "style": "heading"}
              ]
            }
          ]
        }
      ],
      "animations": [{"action": "fade-in", "target": "impact_stage", "at": "0.2s", "duration": "0.8s"}]
    },
    {
      "id": "final_statement",
      "duration": "5s",
      "template": "storyboard",
      "narration": "QA Copilot brings autonomy into the test cycle.",
      "objects": [
        {
          "type": "group",
          "id": "final_panel",
          "grid": {"region": "stage"},
          "layout": {"type": "stack", "gap": "medium", "align": "center"},
          "children": [
            {"type": "text", "id": "final_title", "content": "QA Copilot", "style": "heading"},
            {"type": "text", "id": "final_subtitle", "content": "Autonomy in the test cycle", "style": "caption"},
            {"type": "text", "id": "final_footer", "content": "Built for CQA", "style": "caption"}
          ]
        }
      ],
      "animations": [{"action": "fade-in", "target": "final_panel", "at": "0s", "duration": "1s"}]
    }
  ]
}
