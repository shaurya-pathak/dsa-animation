{
  "version": "1.4",
  "meta": {
    "title": "System Storyboard Demo",
    "resolution": [1920, 1080],
    "fps": 30,
    "theme": "storyboard_dark",
    "show_subtitles": false,
    "continuity": true
  },
  "scenes": [
    {
      "id": "intro",
      "duration": "6s",
      "template": "storyboard",
      "narration": "A good storyboard keeps the same actors on screen while their roles change.",
      "objects": [
        {
          "type": "group",
          "id": "principle_card",
          "grid": {"region": "stage"},
          "layout": {"type": "stack", "gap": "medium", "align": "center"},
          "children": [
            {"type": "text", "id": "principle_title", "content": "System Storyboard", "style": "heading"},
            {"type": "text", "id": "principle_body", "content": "Persistent actors. Clear transformations. Minimal text.", "style": "caption"}
          ]
        }
      ],
      "animations": [
        {"action": "fade-in", "target": "principle_card", "at": "0s", "duration": "1s"}
      ]
    },
    {
      "id": "state",
      "duration": "7s",
      "template": "storyboard",
      "narration": "The same three actors move through the story while the active state becomes the focus.",
      "objects": [
        {"type": "text", "id": "heading_state", "content": "Stable Actors", "style": "heading"},
        {"type": "connector", "id": "state_prev_link", "from": "state_prev", "to": "state_current"},
        {"type": "connector", "id": "state_next_link", "from": "state_current", "to": "state_next"},
        {
          "type": "group",
          "id": "state_stage",
          "grid": {"region": "stage"},
          "layout": {"type": "flow", "direction": "horizontal", "gap": "large", "align": "center"},
          "children": [
            {"type": "box", "id": "state_prev", "actor_id": "actor_request", "content": "Incoming Request", "style": "muted"},
            {"type": "box", "id": "state_current", "actor_id": "actor_triage", "content": "Triage", "style": "primary", "size_variant": "hero"},
            {"type": "box", "id": "state_next", "actor_id": "actor_resolution", "content": "Resolution", "style": "accent"}
          ]
        },
        {
          "type": "group",
          "id": "state_support",
          "grid": {"region": "support"},
          "layout": {"type": "flow", "direction": "horizontal", "gap": "medium", "align": "center"},
          "children": [
            {"type": "token", "id": "state_support_1", "content": "Stable identity", "style": "muted"},
            {"type": "token", "id": "state_support_2", "content": "Clear focus", "style": "muted"},
            {"type": "token", "id": "state_support_3", "content": "Scene continuity", "style": "muted"}
          ]
        }
      ],
      "animations": [
        {"action": "fade-in", "target": "heading_state", "at": "0s", "duration": "0.7s"},
        {"action": "fade-in", "target": "state_stage", "at": "0.2s", "duration": "0.8s"},
        {"action": "draw", "target": "state_prev_link", "at": "0.6s", "duration": "0.6s"},
        {"action": "draw", "target": "state_next_link", "at": "0.9s", "duration": "0.6s"},
        {"action": "highlight", "target": "state_current", "at": "1.2s", "duration": "1.3s", "color": "accent"},
        {"action": "fade-in", "target": "state_support", "at": "1.2s", "duration": "0.7s"}
      ]
    },
