      ],
      "animations": [
        {"id": "show_northstar_heading", "action": "fade-in", "target": "northstar_heading", "at": "1s", "cue": "follow one purchase slowly", "duration": "0.8s"},
        {"id": "show_northstar_order", "action": "fade-in", "target": "northstar_order", "at": "6s", "cue": "buy 100 shares", "duration": "0.9s"},
        {"id": "send_order", "action": "move-to", "target": "northstar_order", "to_id": "broker_a", "at": "16s", "cue": "sends the order to Broker A", "duration": "1.1s", "translate": {"x": -0.7, "y": 0, "basis": "target"}},
        {"id": "show_terms", "action": "fade-in", "target": ["quantity", "agreement_mark", "price"], "at": "21s", "cue": "agree on the quantity and price", "duration": "0.7s", "stagger": "0.2s"},
        {"id": "make_trade_agreed", "action": "replace", "target": "northstar_order", "with": "northstar_agreed", "at": "27s", "cue": "order has been filled", "duration": "0.9s"},
        {"id": "show_not_settled", "action": "fade-in", "target": "not_settled", "at": "35s", "cue": "does not have the shares yet", "duration": "0.8s"}
