        {"id": "draw_cash_route", "action": "draw", "target": "cash_settlement_route", "at": "24s", "cue": "cash moves out", "duration": "0.6s"},
        {"id": "flow_cash", "action": "flow", "target": "cash_settlement_route", "after": "draw_cash_route", "duration": "1.1s", "color": "coral"},
