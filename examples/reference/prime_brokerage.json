                {"type": "semantic_icon", "id": "shares_work", "icon_name": "shares", "content": "Receive shares", "style": "focus-dark", "size_variant": "hero", "visible": false},
                {"type": "semantic_icon", "id": "borrow_work", "icon_name": "borrow", "content": "Borrow shares", "style": "focus-gold", "size_variant": "hero", "visible": false},
