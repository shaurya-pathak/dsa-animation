            {"type": "connector", "id": "shares_settlement_route", "from": "market", "to": "fund", "style": "cyan", "visible": false}
          ]
        }
      ],
      "animations": [
        {"id": "show_check", "action": "fade-in", "target": "check_caption", "at": "5s", "cue": "checks that the details match", "duration": "0.8s"},
        {"id": "show_market", "action": "fade-in", "target": "market", "at": "18s", "cue": "trade settles", "duration": "0.8s"},
