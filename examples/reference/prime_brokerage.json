                {"type": "box", "id": "northstar_position", "actor_id": "northstar_purchase", "continuity_mode": "evolving", "content": "+100 shares   \nNorthstar", "style": "focus-gold", "size_variant": "hero", "grid": {"row": 1, "col": 1}, "visible": false}
