            {"type": "connector", "id": "b_to_warehouse", "from": "broker_b", "to": "warehouse", "style": "gold", "visible": false},
            {"type": "text", "id": "together_caption", "content": "Managed together", "style": "heading", "visible": false}
          ]
        }
      ],
      "animations": [
        {"id": "show_analogy_heading", "action": "fade-in", "target": "analogy_heading", "at": "1s", "cue": "two different storefronts", "duration": "0.8s"},
        {"id": "show_warehouse", "action": "fade-in", "target": "warehouse", "at": "11s", "cue": "one receiving warehouse", "duration": "0.9s"},
        {"id": "draw_a_delivery", "action": "draw", "target": "a_to_warehouse", "at": "14s", "cue": "accepted purchase sent", "duration": "0.7s"},
        {"id": "flow_a_delivery", "action": "flow", "target": "a_to_warehouse", "after": "draw_a_delivery", "duration": "1.2s", "color": "gold"},
        {"id": "draw_b_delivery", "action": "draw", "target": "b_to_warehouse", "at": "16s", "cue": "managed together", "duration": "0.7s"},
        {"id": "flow_b_delivery", "action": "flow", "target": "b_to_warehouse", "after": "draw_b_delivery", "duration": "1.2s", "color": "gold"},
        {"id": "show_together", "action": "fade-in", "target": "together_caption", "at": "18s", "cue": "managed together", "duration": "0.7s"},
        {"id": "name_prime", "action": "replace", "target": "warehouse", "with": "prime_broker", "at": "23s", "cue": "mental model for a prime broker", "duration": "1s"}
      ]
    },
    {
      "id": "northstar_decision_and_fill",
      "duration": "45s",
      "layout": {"type": "center", "gap": "large", "align": "center"},
      "auto_visible": false,
      "show_progress_bar": false,
      "narration": "Let's follow one purchase slowly. The fund decides to buy 100 shares of a fictional company called Northstar. Northstar is just an example we can keep our eyes on from beginning to end. First, the fund sends the order to Broker A. Broker A finds a seller, and they agree on the quantity and price. In market language, the order has been filled. That word only means the trade has been agreed. The fund does not have the shares yet.",
