                {"type": "box", "id": "northstar_agreed", "actor_id": "northstar_purchase", "continuity_mode": "evolving", "content": "Trade agreed  \nNorthstar", "style": "focus-cyan", "size_variant": "hero", "grid": {"row": 1, "col": 1}, "visible": false}
