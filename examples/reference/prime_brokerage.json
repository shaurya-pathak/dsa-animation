                  "layout": {"type": "stack", "gap": "medium", "align": "center"},
                  "visible": true,
                  "children": [
                    {"type": "semantic_icon", "id": "broker_a", "actor_id": "broker_a", "continuity_mode": "position_only", "icon_name": "storefront", "content": "Broker A", "style": "focus-cyan", "size_variant": "hero", "visible": true},
                    {"type": "semantic_icon", "id": "broker_b", "actor_id": "broker_b", "continuity_mode": "position_only", "icon_name": "storefront", "content": "Broker B", "style": "focus-cyan", "size_variant": "hero", "visible": true}
                  ]
                },
                {
                  "type": "group",
                  "id": "warehouse_slot",
                  "layout": {"type": "grid", "columns": 1, "rows": 1, "gap": "small", "align": "center"},
                  "visible": true,
                  "children": [
                    {"type": "semantic_icon", "id": "warehouse", "icon_name": "warehouse", "content": "Receiving warehouse", "style": "focus-gold", "size_variant": "hero", "grid": {"row": 1, "col": 1}, "visible": false},
                    {"type": "semantic_icon", "id": "prime_broker", "actor_id": "prime_broker", "continuity_mode": "position_only", "icon_name": "warehouse", "content": "Prime broker", "style": "focus-gold", "size_variant": "hero", "grid": {"row": 1, "col": 1}, "visible": false}
                  ]
