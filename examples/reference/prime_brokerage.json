  "scenes": [
    {
      "id": "scattered_work",
      "duration": "46s",
      "layout": {"type": "center", "gap": "large", "align": "center"},
      "auto_visible": false,
      "show_progress_bar": false,
      "narration": "Imagine you help operate an investment fund. The fund buys and sells hundreds of investments, and it does not always trade through the same broker. Broker A might find the best price for one order. Broker B might be better for another. That flexibility is useful. But it creates a problem after the trade. Money still has to move. Securities still have to arrive. A short may need borrowed shares. Some positions may need financing. And the fund needs a reliable record of what this prime relationship carries. If every trade stayed in a separate pile at the broker that executed it, the operations team would spend its day piecing those piles together.",
      "objects": [
        {
          "type": "group",
          "id": "scattered_world",
          "layout": {"type": "stack", "gap": "large", "align": "center"},
          "visible": true,
          "children": [
            {"type": "text", "id": "problem_heading", "content": "A trade is only the start", "style": "hero-heading", "visible": false},
            {
              "type": "group",
              "id": "shared_cast",
              "layout": {"type": "flow", "direction": "horizontal", "gap": "large", "align": "center"},
              "visible": true,
              "children": [
                {"type": "semantic_icon", "id": "fund", "actor_id": "fund", "continuity_mode": "position_only", "icon_name": "fund", "content": "Fund", "style": "focus-coral", "size_variant": "hero", "visible": false},
                {"type": "semantic_icon", "id": "broker_a", "actor_id": "broker_a", "continuity_mode": "position_only", "icon_name": "storefront", "content": "Broker A", "style": "focus-cyan", "size_variant": "hero", "visible": false},
                {"type": "semantic_icon", "id": "broker_b", "actor_id": "broker_b", "continuity_mode": "position_only", "icon_name": "storefront", "content": "Broker B", "style": "focus-cyan", "size_variant": "hero", "visible": false}
              ]
            },
